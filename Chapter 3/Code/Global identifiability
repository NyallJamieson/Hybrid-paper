simulate_mtbp_thresholds <- function(
    dose,
    alpha,
    beta,
    lambda,
    G,
    r,
    t_max = 500,
    max_events = 1e7
) {
  time <- 0
  L <- dose
  M <- 0

  time_sde <- NA_real_
  time_ode <- NA_real_
  time_ill <- NA_real_

  for (event_i in seq_len(max_events)) {

    # Record first passage to each state-space threshold.
    if (is.na(time_sde) &&
        L >= L_sde_switch &&
        M >= M_sde_switch) {
      time_sde <- time
    }

    if (is.na(time_ode) &&
        L >= L_ode_switch &&
        M >= M_ode_switch) {
      time_ode <- time
    }

    if (L >= LT) {
      time_ill <- time
      return(list(
        status = "LT",
        time_sde = time_sde,
        time_ode = time_ode,
        time_ill = time_ill,
        final_L = L,
        final_M = M,
        events = event_i
      ))
    }

    if (L <= 0 && M <= 0) {
      return(list(
        status = "extinct",
        time_sde = time_sde,
        time_ode = time_ode,
        time_ill = NA_real_,
        final_L = L,
        final_M = M,
        events = event_i
      ))
    }

    if (time >= t_max) {
      return(list(
        status = "max_time",
        time_sde = time_sde,
        time_ode = time_ode,
        time_ill = NA_real_,
        final_L = L,
        final_M = M,
        events = event_i
      ))
    }

    rates <- c(
      successful_phagocytosis = alpha * L,
      failed_phagocytosis = beta * L,
      rupture = lambda * M
    )

    total_rate <- sum(rates)

    if (!is.finite(total_rate) || total_rate <= 0) {
      return(list(
        status = "extinct",
        time_sde = time_sde,
        time_ode = time_ode,
        time_ill = NA_real_,
        final_L = L,
        final_M = M,
        events = event_i
      ))
    }

    time <- time + rexp(1, rate = total_rate)
    event <- sample.int(3, size = 1, prob = rates / total_rate)

    if (event == 1) {
      L <- L - 1
      M <- M + 1
    } else if (event == 2) {
      L <- L - 1
    } else {
      released <- rnbinom(1, mu = G, size = r)
      L <- L + released
      M <- M - 1
    }

    L <- max(L, 0)
    M <- max(M, 0)
  }

  list(
    status = "max_events",
    time_sde = time_sde,
    time_ode = time_ode,
    time_ill = NA_real_,
    final_L = L,
    final_M = M,
    events = max_events
  )
}

safe_mean <- function(x) {
  if (sum(is.finite(x)) == 0) return(NA_real_)
  mean(x[is.finite(x)])
}

safe_median <- function(x) {
  if (sum(is.finite(x)) == 0) return(NA_real_)
  median(x[is.finite(x)])
}

safe_sd <- function(x) {
  if (sum(is.finite(x)) <= 1) return(NA_real_)
  sd(x[is.finite(x)])
}

safe_quantile <- function(x, p) {
  if (sum(is.finite(x)) == 0) return(NA_real_)
  unname(quantile(x[is.finite(x)], probs = p, names = FALSE))
}

summarise_time <- function(x, prefix, min_n = 10) {
  ok <- is.finite(x)
  n_ok <- sum(ok)

  values <- c(
    n = n_ok,
    probability = mean(ok),
    mean_hours = if (n_ok >= min_n) safe_mean(x) else NA_real_,
    median_hours = if (n_ok >= min_n) safe_median(x) else NA_real_,
    sd_hours = if (n_ok >= min_n) safe_sd(x) else NA_real_,
    q025_hours = if (n_ok >= min_n) safe_quantile(x, 0.025) else NA_real_,
    q975_hours = if (n_ok >= min_n) safe_quantile(x, 0.975) else NA_real_
  )

  names(values) <- paste0(prefix, "_", names(values))
  values
}

