variance_decomposition_one <- function(raw_data, time_column) {
  split_times <- split(
    raw_data[[time_column]],
    raw_data$parameter_set
  )

  set_means <- vapply(split_times, safe_mean, numeric(1))
  set_variances <- vapply(split_times, function(x) {
    x <- x[is.finite(x)]
    if (length(x) <= 1) return(NA_real_)
    var(x)
  }, numeric(1))

  between_parameter_variance <- var(set_means, na.rm = TRUE)
  mean_within_parameter_variance <- mean(set_variances, na.rm = TRUE)
  total_descriptive_variance <-
    between_parameter_variance + mean_within_parameter_variance

  data.frame(
    outcome = time_column,
    between_parameter_variance = between_parameter_variance,
    mean_within_parameter_stochastic_variance =
      mean_within_parameter_variance,
    stochastic_fraction = mean_within_parameter_variance /
      total_descriptive_variance,
    parameter_fraction = between_parameter_variance /
      total_descriptive_variance
  )
}

