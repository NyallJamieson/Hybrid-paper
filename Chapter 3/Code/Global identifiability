latin_hypercube <- function(n, d) {
  out <- matrix(NA_real_, nrow = n, ncol = d)

  for (j in seq_len(d)) {
    # One sample from each equally sized interval, randomly permuted.
    points <- ((seq_len(n) - 1) + runif(n)) / n
    out[, j] <- sample(points, size = n, replace = FALSE)
  }

  out
}

scale_to_bounds <- function(u, lower, upper) {
  lower + u * (upper - lower)
}

lhs_unit <- latin_hypercube(
  n = n_parameter_sets,
  d = nrow(parameter_bounds)
)

parameter_sets <- as.data.frame(lhs_unit)
names(parameter_sets) <- parameter_bounds$parameter

for (j in seq_len(nrow(parameter_bounds))) {
  nm <- parameter_bounds$parameter[j]
  parameter_sets[[nm]] <- scale_to_bounds(
