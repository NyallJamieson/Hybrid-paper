standardised_regression <- function(data, outcome, parameters) {
  dd <- data[complete.cases(data[, c(outcome, parameters)]), , drop = FALSE]

  if (nrow(dd) < length(parameters) + 10) {
    return(NULL)
  }

  zdata <- as.data.frame(scale(dd[, c(outcome, parameters)]))
  fit <- lm(reformulate(parameters, response = outcome), data = zdata)
  sm <- summary(fit)

  coef_table <- as.data.frame(sm$coefficients)
  coef_table$term <- rownames(coef_table)
  rownames(coef_table) <- NULL
  names(coef_table)[1:4] <- c(
    "standardised_coefficient",
    "standard_error",
    "t_value",
    "p_value"
  )

  coef_table$outcome <- outcome
  coef_table$r_squared <- sm$r.squared
  coef_table$adjusted_r_squared <- sm$adj.r.squared
  coef_table$n_parameter_sets_used <- nrow(dd)

  coef_table[
    coef_table$term != "(Intercept)",
    c(
      "outcome",
      "term",
      "standardised_coefficient",
      "standard_error",
      "t_value",
      "p_value",
      "r_squared",
      "adjusted_r_squared",
      "n_parameter_sets_used"
    )
  ]
}

