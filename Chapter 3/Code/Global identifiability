# PRCC is calculated by:
#   1. rank-transforming every parameter and outcome;
#   2. regressing the selected parameter on all other parameters;
#   3. regressing the outcome on all other parameters;
#   4. correlating the two sets of residuals.
#
# A large absolute PRCC means that a parameter has a strong
# monotonic association with the outcome after controlling for
# the other sampled parameters.

prcc_one <- function(data, outcome, parameter, all_parameters) {
  needed <- c(outcome, all_parameters)
  dd <- data[complete.cases(data[, needed]), needed, drop = FALSE]

  if (nrow(dd) < length(all_parameters) + 10) {
    return(c(prcc = NA_real_, p_value = NA_real_, n = nrow(dd)))
  }

  ranked <- as.data.frame(lapply(dd, rank, ties.method = "average"))

  others <- setdiff(all_parameters, parameter)

  if (length(others) == 0) {
    test <- cor.test(
      ranked[[parameter]],
      ranked[[outcome]],
      method = "pearson"
    )
    return(c(
      prcc = unname(test$estimate),
      p_value = test$p.value,
      n = nrow(ranked)
    ))
  }

  x_formula <- reformulate(others, response = parameter)
  y_formula <- reformulate(others, response = outcome)

  x_resid <- residuals(lm(x_formula, data = ranked))
  y_resid <- residuals(lm(y_formula, data = ranked))

  test <- cor.test(x_resid, y_resid, method = "pearson")

  c(
    prcc = unname(test$estimate),
    p_value = test$p.value,
    n = nrow(ranked)
  )
}

bootstrap_prcc <- function(
    data,
    outcome,
    parameter,
    all_parameters,
    B = 500
) {
  needed <- c(outcome, all_parameters)
  dd <- data[complete.cases(data[, needed]), , drop = FALSE]

  if (B <= 0 || nrow(dd) < length(all_parameters) + 10) {
    return(c(ci_lower = NA_real_, ci_upper = NA_real_))
  }

  vals <- rep(NA_real_, B)

  for (b in seq_len(B)) {
    idx <- sample.int(nrow(dd), nrow(dd), replace = TRUE)
    vals[b] <- prcc_one(
      dd[idx, , drop = FALSE],
      outcome,
      parameter,
      all_parameters
    )[["prcc"]]
  }

  c(
    ci_lower = unname(quantile(vals, 0.025, na.rm = TRUE)),
    ci_upper = unname(quantile(vals, 0.975, na.rm = TRUE))
  )
}

