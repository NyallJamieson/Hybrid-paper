a <- 0.089
b <- 1.088
h <- 0.041
m <- 62.792
G <- m
r <- 36.072
 
# Extinction G NB
model <- function(t,y,parms){
dy1 <- -(a+b)*y[1]+a*y[2]+b
dy2 <- -h*y[2]+h*(r/(m+r-y[1]*m))^(r)
list(c(dy1,dy2))
}
yini <- c(y1=0,y2=0)
times <- seq(from=0,to=150,by=0.01)
out1 <- deSolve::ode(times=times,y=yini,func=model,parms=NULL)
plot(out1[,1],out1[,2],type="l",col="red",xlim=c(0,20),lwd=2,xlab="Time in Hours",ylab=expression(q),main="Extinction Probability of MTBP starting with 1 Legionella",ylim=c(0,1))
 
###
T3_varying <- c()

for (n in 1:250){
print(n)

prob <- out1[,2]^n

eps <- seq(0.00001,0.1,by=0.00001)
TIMES <- c()
 
for (i in 1:length(eps)){
TIMES <- append(TIMES,out1[length(which(prob<prob[1501]-eps[i])),1])}
grad <- (TIMES[length(TIMES)]-TIMES[1])/(eps[length(eps)]-eps[1])
dis <- c()
for (i in 1:length(eps)){
dis <- append(dis,TIMES[1]+grad*eps[i]-TIMES[i])}
t <- which(dis==max(dis))

T3_varying <- append(T3_varying,TIMES[t])
}

plot(seq(1,150,by=1),T3_varying,xlab="Deposited dose",ylab=expression(T[3]),col="red",type="l",lwd=3,main=expression(T[3]~" estimate for varying deposited dose")
