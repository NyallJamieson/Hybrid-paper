# NB Jump SDE

# tau leap simulation for Jump process

times2 <- c()

while (length(times2)<10000){

dt <- 0.1
t <- seq(0,300,by=dt)
l <- rep(0,length(t))
m <- rep(0,length(t))
l[1] <- 1

for (i in 2:3001){

e1 <- rpois(n=1,lambda=dt*b*l[i-1])
e2 <- rpois(n=1,lambda=dt*a*l[i-1])
e3 <- rpois(n=1,lambda=dt*h*m[i-1])
if (e3==0){
e4 <- 0}
else {
e4 <- rnbinom(n=e3,mu=61.39,size=29.52)}

l[i] <- l[i-1] - (e1+e2) + e4
m[i] <- m[i-1] + e2 - e3

if (l[i]<0){
l[i] <- 0}
if (m[i]<0){
m[i] <- 0}

if (l[i]>181.9034 && m[i]>38.19993){
times2 <- append(times2,t[i])
print(length(times2))
break}
}
}



